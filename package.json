{
  "name": "ole-production-logger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\" \"tests/**/*.js\"",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit --coverage",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push --linked"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "chart.js": "^4.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@sinonjs/fake-timers": "^13.0.0",
    "@size-limit/preset-app": "^11.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "size-limit": "^11.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
