{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/admin", "destination": "/pages/admin.html" },
    { "source": "/graficas", "destination": "/pages/graficas.html" },
    { "source": "/mockups", "destination": "/pages/mockups.html" },
    { "source": "/mockup-1", "destination": "/pages/mockup-1.html" },
    { "source": "/mockup-2", "destination": "/pages/mockup-2.html" },
    { "source": "/mockup-3", "destination": "/pages/mockup-3.html" },
    { "source": "/mockup-4", "destination": "/pages/mockup-4.html" },
    { "source": "/mockup-5", "destination": "/pages/mockup-5.html" },
    { "source": "/mockup-2-tablero", "destination": "/pages/mockup-2-tablero.html" },
    { "source": "/mockup-2-admin", "destination": "/pages/mockup-2-admin.html" },
    { "source": "/mockup-2-graficas", "destination": "/pages/mockup-2-graficas.html" },
    { "source": "/mockup-2-capture", "destination": "/pages/mockup-2-capture.html" },
    { "source": "/header-mockups", "destination": "/pages/header-mockups.html" },
    { "source": "/mobile-mockups", "destination": "/pages/mobile-mockups.html" },
    { "source": "/mobile-operator", "destination": "/pages/mobile-operator.html" },
    { "source": "/mobile-tablero", "destination": "/pages/mobile-tablero.html" },
    { "source": "/mobile-graficas", "destination": "/pages/mobile-graficas.html" },
    { "source": "/mobile-admin", "destination": "/pages/mobile-admin.html" },
    { "source": "/mobile-capture", "destination": "/pages/mobile-capture.html" },
    { "source": "/nav-mockups", "destination": "/pages/nav-mockups.html" },
    { "source": "/nav-mockup-1", "destination": "/pages/nav-mockup-1.html" },
    { "source": "/nav-mockup-2", "destination": "/pages/nav-mockup-2.html" },
    { "source": "/nav-mockup-3", "destination": "/pages/nav-mockup-3.html" },
    { "source": "/nav-mockup-4", "destination": "/pages/nav-mockup-4.html" },
    { "source": "/nav-mockup-5", "destination": "/pages/nav-mockup-5.html" },
    { "source": "/kpi-mockups", "destination": "/pages/kpi-mockups.html" },
    { "source": "/kpi-mockup-1", "destination": "/pages/kpi-mockup-1.html" },
    { "source": "/kpi-mockup-2", "destination": "/pages/kpi-mockup-2.html" },
    { "source": "/kpi-mockup-3", "destination": "/pages/kpi-mockup-3.html" },
    { "source": "/kpi-mockup-4", "destination": "/pages/kpi-mockup-4.html" },
    { "source": "/kpi-mockup-5", "destination": "/pages/kpi-mockup-5.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
